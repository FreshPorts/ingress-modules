#!/bin/sh
#
# $Id: config.sh.sample,v 1.1.2.7 2004-10-03 02:19:59 dan Exp $
#

BASEDIR="/usr/websites/DIRNAME"

# what is the URL for this website?
WEBSITEURL="http://WEBSITE_URL"

#
# where do I find files such as load_xml_into_db.pl
#
SCRIPTDIR="${BASEDIR}/scripts"

#
# Where does the msg directory start?
# This directory should contain the files
# created by ${SCRIPTDIR}/procmail/create_dirs.sh
# and be the value which supplied to that script.
#
MSGDIR="MSG_ARCHIVE"

CACHEDIR="${BASEDIR}/caching/cache"
STAGINGDIR="${BASEIDR}/caching/tmp"

# What file do we set for /usr/ports/MOVED?

MOVEDFLAGFILE="${BASEDIR}/dynamic/refresh_moved"

# What file do we set for /usr/ports/UPDATING?

UPDATINGFLAGFILE="${BASEDIR}/dynamic/refresh_moved"

PORTSFREEZEFILE="${BASEDIR}/dynamic/PortsFreezeIsOn"

VUXMLFLAGFILE="${BASEDIR}/dynamic/vuxml"

PORTSDIR="PORTS_DIR"
ADMINEMAIL="ADMIN_EMAIL"

if [ -e 'OFFLINE' ]
then
	OFFLINE=1;
else
	OFFLINE=0;
fi

# $Id: config.sh.sample,v 1.1.2.3 2003-11-14 17:56:06 dan Exp $
#

# what is the URL for this website?
WEBSITEURL="http://working-copy.freshports.org"

#
# where do I find files such as load_xml_into_db.pl
#
SCRIPTDIR="/path/to/scripts/directory"

#
# Where does the msg directory start?
# This directory should contain the files
# created by ${SCRIPTDIR}/procmail/create_dirs.sh
# and be the value which supplied to that script.
#
MSGDIR="/path/to/msg/directory"

CACHEDIR="/usr/websites/freshports.org/caching/cache"
STAGINGDIR="/usr/websites/freshports.org/caching/tmp"

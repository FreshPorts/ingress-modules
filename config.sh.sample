#!/bin/sh
#
# $Id: config.sh.sample,v 1.10 2012-12-29 19:24:35 dan Exp $
#

# this must always be defined and functional.
FRESHPORTS_FREEBSD_CVS_URL="http://www.freebsd.org/cgi/cvsweb.cgi"

FETCH="/usr/bin/fetch"
FETCH_OPTIONS="-qo"

# where is this website installed?
# do not include a trailing slash
# this directory should contain the www and scripts directories.
BASEDIR="/usr/websites/DIRNAME"

#
# the directory where logs go.  used mainly for notifications
# and outputs of vuxml processing
#
DIRLOG="${BASEDIR}/scripts-log"

# what is the URL for this website?
# MUST have a trailing /
WEBSITEURL="http://WEBSITE_URL"

#
# where do I find files such as load_xml_into_db.pl
#
SCRIPTDIR="${BASEDIR}/scripts"

#
# Where does the msg directory start?
# This directory should contain the files
# created by ${SCRIPTDIR}/procmail/create_dirs.sh
# and be the value which supplied to that script.
#
MSGDIR="MSG_ARCHIVE"

CACHINGROOT="${BASEDIR}/dynamic/caching"

CACHEDIR="${CACHINGROOT}/cache"
NEWSCACHEDIR="${CACHINGROOT}/news"
SPOOLINGDIR="${CACHINGROOT}/tmp"

# What file do we set for /usr/ports/MOVED?

MOVEDFLAGFILE="${BASEDIR}/dynamic/refresh_moved"

# What file do we set for /usr/ports/UPDATING?

UPDATINGFLAGFILE="${BASEDIR}/dynamic/refresh_updating"

PORTSFREEZEFILE="${BASEDIR}/dynamic/PortsFreezeIsOn"

VUXMLFLAGFILE="${BASEDIR}/dynamic/vuxml"
VUXMLMUTEX="${BASEDIR}/dynamic/vuxml_mutex"
WWWENPORTSCATEGORIES="${BASEDIR}/dynamic/www.en.ports.categories"

CACHE_NEEDS_REFRESH="${BASEDIR}/dynamic/cache_needs_refresh"

PORTSDIR="PORTS_DIR"
ADMINEMAIL="ADMIN_EMAIL"

if [ -e 'OFFLINE' ]
then
	OFFLINE=1;
else
	OFFLINE=0;
fi

# define your local cvsup host here
FREEBSDCVSUPHOST="cvsup.unixathome.org"

# scripts for the jail
FRESHPORTS_JAIL_BASE_DIR="/wdc/dan/FreshPorts/ports-jail"
FRESHPORTS_JAIL_MASTER_PORT_SCRIPT="make-master-port-test.sh"

#
# $Id: dot.procmailrc,v 1.2 2006-12-17 12:04:07 dan Exp $
#
# Copyright (c) 1999-2002 DVL Software
#
# Please check if all the paths in PATH are reachable, 
# remove the ones that are not.

PATH=/usr/bin:/usr/ucb:/bin:/usr/local/bin:.
MAILDIR=$HOME/mail	# You'd better make sure it exists
DEFAULT=$MAILDIR/mbox
LOGFILE=$MAILDIR/procmail.log
#VERBOSE=yes
LOCKFILE=$HOME/.lockmail
UMASK=022

#
# a file of the form YYYY.MM.DD.HH.MM.SS.PID.txt
#
FILE=`date +%Y.%m.%d.%H.%M.%S`.$$.txt

:0
* ! ^X-List-Administrivia: yes
* ^Sender: (owner-svn-ports-branches@freebsd.org|owner-cvs-all@freebsd.org|owner-cvs-doc@freebsd.org|owner-cvs-ports@freebsd.org|owner-cvs-projects@freebsd.org|owner-cvs-src-old@FreeBSD.ORG|owner-svn-src-all@freebsd.org|owner-svn-doc-all@freebsd.org|owner-svn-ports-head@freebsd.org)
{
   #
   # this should restrict all entries to just that from the mailing list
   # 
   :0
   * (^X-FreeBSD-CVS-Branch: *|X-SVN-Group: *)
   {

      MSGDIR=$HOME/message-queues
      TMPDIR=$MSGDIR/spooling
      SPOOL=${TMPDIR}/${FILE}
      DEST=${MSGDIR}/incoming/${FILE}
      TRAP='echo \$SPOOL is $SPOOL && echo \$DEST. is $DEST'
      :0
         | cat > ${SPOOL} && mv ${SPOOL} ${DEST}
   }

   #
   # we don't want anything else from this list
   #
   :0
      /dev/null
}

:0
!dan@langille.org

#
# use /bin/sh to run commands, overriding the default set by cron
SHELL=/bin/sh
# mail any output to `paul', no matter whose crontab this is
MAILTO=dan

YYYY_MM_DD=`eval date -v-${DAYS}d "+%Y-%m-%d"`

DIR=/usr/websites/WEBSITE-NAME/scripts

0	1	*		*	*	nice -15 sh -c '(cd ${DIR} && sh ./database_dump.sh 2>&1 | mail -s "freshports Backup" root)'

10	18	*		*	*	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-notification.pl D 2>&1 | mail -s "freshports NEW daily notice"       root)'
0	19	*		*	2	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-notification.pl W 2>&1 | mail -s "freshports NEW weekly notice"      root)'
20	19	9,23	*	*	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-notification.pl F 2>&1 | mail -s "freshports NEW fortnightly notice" root)'
40	19	23		*	*	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-notification.pl M 2>&1 | mail -s "freshports NEW monthly notice"     root)'

10	18	*		*	*	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-new-ports.pl D 2>&1 | mail -s "freshports NEW ports daily notice"       root)'
0	19	*		*	2	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-new-ports.pl W 2>&1 | mail -s "freshports NEW ports weekly notice"      root)'
20	19	9,23	*	*	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-new-ports.pl F 2>&1 | mail -s "freshports NEW ports fortnightly notice" root)'
40	19	23		*	*	nice -15 sh -c '(cd ${DIR} && /usr/bin/perl ./report-new-ports.pl M 2>&1 | mail -s "freshports NEW ports monthly notice"     root)'

0	0	*		*	*	nice -15 sh -c '(cd ${DIR} && /bin/sh ./searchlog.sh 2>&1 | mail -s "freshports searchlog" dan@langille.org)'
0	0	*		*	*	nice -15 sh -c '(cd ${DIR} && /bin/sh ./newusers.sh  2>&1 | mail -s "FreshPorts users"     dan@langille.org)'

10	15	*		*	*	/usr/local/bin/cvsup -b ${HOME} -h cvsup ${DIR}/ports-supfile | mail -s "working-copy cvsup" root

*/10	*	*	*	*	cd $DIR && perl unrefreshed.pl    2>&1 > /dev/null
0		0	*	*	*	cd $DIR && perl unrefreshed.pl -i 2>&1 > /dev/null
0		*	*	*	*	cd $DIR && perl hourly_stats.pl   2>&1 > /dev/null
0		0	*	*	*	cd $DIR && perl daily_stats.pl    2>&1 > /dev/null

3		0	*	*	*	cd $DIR && sh daily_rendering_times.sh 1
# 2>&1 > /dev/null

*/5 *   *       *   *   cd $DIR && ./cache-refresh.sh  > /dev/null 2>&1

10	0	*		*	*	cd $DIR && ./archive-messages.sh >> /dev/null

17	0	*		*	*	cd $DIR && sh ./vacuum.sh 2>&1 > /dev/null

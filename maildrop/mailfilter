#
# For FreshPorts ingress email
#

# log everything here
logfile "$HOME/mail/mailfilter.log"

# but nothing should be store locally in any mailbox
TYPE=mbox

# unrecognized or list admin messages are sent here
FORWARDING="dan@langille.org"

# should never be used, but defined anyway
DEFAULT="$HOME/mail/mbox"

UMASK=022

#
# File of the form YYYY.MM.DD.HH.MM.SS.PID.txt
# This should be unique, not that there is another process doing this.
#
PROCESS_ID=`echo $$`
FILE=`date +%Y.%m.%d.%H.%M.%S`.$PROCESS_ID.txt

#
# do not process any subscribe / unsubscribe emails
#
if ( /^X-List-Administrivia: yes/ )
{
  to $FORWARDING
}

# we are only interested in messages from these owners
if ( /^Sender: (owner-svn-doc-all|owner-svn-ports-branches|owner-svn-ports-head|owner-svn-src-all|owner-cvs-doc|owner-cvs-ports|owner-cvs-projects|owner-cvs-all|)@freebsd.org/ )
{
  #
  # if the email has these headers, we process it
  #
  if ( /^(X-SVN-Group: *|X-FreeBSD-CVS-Branch: *)/ )
  {
    MSGDIR=$HOME/message-queues
    TMPDIR=$MSGDIR/spooling
    SPOOL=${TMPDIR}/${FILE}
    DEST=${MSGDIR}/incoming/${FILE}
    echo "SPOOL is $SPOOL"
    echo "DEST  is $DEST"

    # save to a file, avoiding race condition
    to "|> $SPOOL; /bin/mv ${SPOOL} ${DEST}"
  }
  else
  {
    # discard this message, we are not interested. It is someone replying to an email
    exit
  }
}

#
# anything else, should be forwarded. We do not accumulate email here
#
to $FORWARDING

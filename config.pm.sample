package FreshPorts::Config;

use Cwd;

#
# This section contains local settings.  Change them to suit your environment.
#

$FreshPorts::Config::FreshPortsURL		= 'http://WEBSITE_URL/';

$FreshPorts::Config::TimeAdjust			= '-10800 seconds';

$FreshPorts::Config::dbname				= 'databasename';
$FreshPorts::Config::user				= 'user';
$FreshPorts::Config::password			= 'password';

$FreshPorts::Config::BaseDir			= "/usr/websites/WEBSITE_URL";

$FreshPorts::Config::scriptpath			= $FreshPorts::Config::BaseDir . '/scripts';

$FreshPorts::Config::mkdir_pkg			= 0;

#
# where on disk is the ports tree?
#
$FreshPorts::Config::path_to_tree		= $ENV{HOME};

#
# path to ports tree. no trailing slash
#
$FreshPorts::Config::path_to_ports		= $FreshPorts::Config::path_to_tree . '/ports';

#
# where in the cvs tree are ports?
#
$FreshPorts::Config::ports_prefix		= 'ports';

$FreshPorts::Config::DailySummaryDir	= $FreshPorts::Config::BaseDir . "/www/archives"; # no trailing /
$FreshPorts::Config::HourlySummaryDir	= $FreshPorts::Config::BaseDir . "/dynamic";

$FreshPorts::Config::CommitterNotify	= 0;	# Should we notify committers of problems?
$FreshPorts::Config::NotifyAdmin        = 1;	# Notify me

#
# Change only above. Do not change below.
#

#
# ensure we have the real path names here...
# otherwise we'll have trouble with determining relative pathnames
#
$FreshPorts::Config::scriptpath			= Cwd::abs_path($FreshPorts::Config::scriptpath);
$FreshPorts::Config::path_to_tree		= Cwd::abs_path($FreshPorts::Config::path_to_tree);	
$FreshPorts::Config::path_to_ports		= Cwd::abs_path($FreshPorts::Config::path_to_ports);

$FreshPorts::Config::email_server		= 'localhost';
$FreshPorts::Config::email_port			= 25;
$FreshPorts::Config::email_client		= 'localhost';

$FreshPorts::Config::SystemOwnerEmail	= 'dan@langille.org';

$FreshPorts::Config::JobWaiting			= $FreshPorts::Config::BaseDir . '/dynamic/job_waiting';
$FreshPorts::Config::MovedFileFlag		= $FreshPorts::Config::BaseDir . '/dynamic/refresh_moved';
$FreshPorts::Config::UpdatingFileFlag	= $FreshPorts::Config::BaseDir . '/dynamic/refresh_updating';
$FreshPorts::Config::VuXMLFileFlag		= $FreshPorts::Config::BaseDir . '/dynamic/vuxml';

$FreshPorts::Config::PortsFreezeFile    = $FreshPorts::Config::BaseDir . '/dynamic/PortsFreezeIsInEffect';

#
# For fetching files from CVS
#
$FreshPorts::Config::CVS_Repository		= "http://www.freebsd.org/cgi/cvsweb.cgi";

#
# for debugging....
#
#print "\$FreshPorts::Config::scriptpath    '$FreshPorts::Config::scriptpath'\n";
#print "\$FreshPorts::Config::path_to_tree  '$FreshPorts::Config::path_to_tree'\n";
#print "\$FreshPorts::Config::path_to_ports '$FreshPorts::Config::path_to_ports'\n";

1;

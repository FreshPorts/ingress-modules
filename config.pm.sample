package FreshPorts::Config;

$FreshPorts::Config::scriptpath			= $ENV{HOME} . "/scripts";

$FreshPorts::Config::dbname				= 'database';
$FreshPorts::Config::user				= 'user';
$FreshPorts::Config::password			= '';

$FreshPorts::Config::path_to_tree		= $ENV{HOME};								# where on disk is the ports tree?
$FreshPorts::Config::path_to_ports		= $FreshPorts::Config::path_to_tree . '/ports';	# path to ports tree. no trailing slash
$FreshPorts::Config::ports_prefix		= 'ports';										# where in the cvs tree are ports?

$FreshPorts::Config::DailySummaryDir	= $ENV{HOME} . "/src/www/archives"; # no trailing /

1;
